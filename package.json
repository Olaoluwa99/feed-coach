{
  "name": "feed-coach",
  "version": "0.3.0",
  "private": true,
  "description": "A browser extension that helps you steer your YouTube feed toward what you want, and measures whether it worked.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olaoluwa99/feed-coach.git"
  },
  "homepage": "https://github.com/Olaoluwa99/feed-coach",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node build.mjs && node scripts/package.mjs",
    "check": "tsc --noEmit && vitest run && node build.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
